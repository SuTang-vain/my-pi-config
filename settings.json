{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultModel": "deepseek-flash",
  "defaultProvider": "deepseek",
  "defaultThinkingLevel": "high",
  "compaction": {
    "reserveTokens": 48000,
    "keepRecentTokens": 60000
  },
  "modelThinkingLevels": {
    "zai-coding-cn/glm-5.3-flash": "max",
    "kimi-coding/kimi-for-coding-highspeed": "high",
    "deepseek/deepseek-flash": "max",
    "kimi-coding/k3": "max",
    "kimi-coding/kimi-for-coding": "max",
    "zai-coding-cn/glm-5.3": "max",
    "deepseek/deepseek-v4-pro": "max",
    "kimi-coding/k3-256k": "max"
  },
  "showCacheMissNotices": true,
  "skills": [
    "~/.pi/agent/skills-optional/scientific-agent-skills/skills/exa-search/SKILL.md",
    "~/.pi/agent/skills-optional/scientific-agent-skills/skills/pi-agent/SKILL.md",
    "~/.pi/agent/skills-optional/scientific-agent-skills/skills/literature-review/SKILL.md",
    "~/.pi/agent/skills-optional/scientific-agent-skills/skills/paper-lookup/SKILL.md"
  ],
  "theme": "catppuccin-mocha",
  "tuiMode": "fullscreen",
  "packages": [
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-goal-x",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-btw"
  ],
  "quietStartup": "header"
}
