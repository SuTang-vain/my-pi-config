# dot.terminal-notifier — 配置模板（herdr 插件，不是 pi 脚本）
#
# 安装位置：$(herdr plugin config-dir dot.terminal-notifier)/config.env
# 完整方法：~/.pi/agent/docs-notes/macos-notifications.md
#
# 状态词表：herdr 的"完成"有两个词 —— 后台 workspace 记 done，
# 当前聚焦的 workspace 记 idle（视为已看过）。所以三个都要触发，
# 只写 done 会漏「同一 workspace 内切到别的 App」，只写 idle 会漏后台 workspace。
TRIGGER_STATUSES="blocked done idle"

# 降噪：仅当「event 的 workspace 就是 herdr 内聚焦的 workspace」且
# 「终端是前台 App」时静音（lsappinfo 判前台，判不出则照发）
SUPPRESS_FOCUSED=1
# 点通知 → 切 pane + 激活终端。插件只发 -execute、不发 -activate，
# 少了 `open -b` 就会"点了没反应"。换终端时改这里的 bundle id。
ACTIVATE_ON_CLICK=1
CLICK_COMMAND="agent focus {pane}; open -b com.mitchellh.ghostty"
DEBOUNCE_SECONDS=2

# {title} = pane 终端标题 = pi 的会话名（"π - 任务摘要"），比 workspace 名信息量大
TITLE_BLOCKED="{title}"
BODY_BLOCKED="⏳ 需要你的输入 · {agent} · {tab_label}"
TITLE_DONE="{title}"
BODY_DONE="✅ 已完成 · {agent} · {tab_label}"

ICON_BLOCKED="assets/icons/blocked.png"
ICON_DONE="assets/icons/done.png"
SOUND_BLOCKED="Glass"
SOUND_DONE="Hero"

# 每个 pane 的每个状态各自一组：done 不会顶掉还没看的 blocked
GROUP="{pane}-{new_status}"

# 设 1 后把每次事件的决策写到
# ~/.local/state/herdr/plugins/dot.terminal-notifier/last-event.json
DEBUG=0
