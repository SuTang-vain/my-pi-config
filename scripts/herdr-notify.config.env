# dot.terminal-notifier — configuration template (herdr plugin, not a pi script)
#
# Install location: $(herdr plugin config-dir dot.terminal-notifier)/config.env
# Full procedure: docs/macos-notifications.md
#
# Status vocabulary: herdr has two words for "finished". A completion in a background workspace
# is reported as `done`; a completion in the focused workspace is reported as `idle` (treated as
# already seen). All three states must therefore be listed, or one of the two cases is missed.
TRIGGER_STATUSES="blocked done idle"

# Noise control: stay silent only when the event's workspace is the one focused inside herdr
# AND the terminal is the frontmost application (resolved with lsappinfo; undetectable means
# notify anyway).
SUPPRESS_FOCUSED=1
# Clicking a notification focuses the pane and raises the terminal. The plugin only passes
# -execute, never -activate, so `open -b` is required or the click appears to do nothing.
# Replace the bundle identifier when using a different terminal.
ACTIVATE_ON_CLICK=1
CLICK_COMMAND="agent focus {pane}; open -b com.mitchellh.ghostty"
DEBOUNCE_SECONDS=2

# {title} is the pane's terminal title, i.e. the session name — more informative than the
# workspace label.
TITLE_BLOCKED="{title}"
BODY_BLOCKED="input required · {agent} · {tab_label}"
TITLE_DONE="{title}"
BODY_DONE="finished · {agent} · {tab_label}"

ICON_BLOCKED="assets/icons/blocked.png"
ICON_DONE="assets/icons/done.png"
SOUND_BLOCKED="Glass"
SOUND_DONE="Hero"

# One group per (pane, status): a completion never hides an unread blocked notification.
GROUP="{pane}-{new_status}"

# Set to 1 to write each event's decision to
# ~/.local/state/herdr/plugins/dot.terminal-notifier/last-event.json
DEBUG=0
